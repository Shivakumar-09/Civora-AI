// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Election {
  id          String      @id @default(cuid())
  title       String
  type        ElectionType
  state       String?     // null for national
  phase       String?
  pollingDate DateTime
  resultDate  DateTime?
  deadline    DateTime?   // registration deadline
  status      ElectionStatus @default(UPCOMING)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  candidates  Candidate[]
  reminders   Reminder[]

  @@map("elections")
}

model Candidate {
  id              String   @id @default(cuid())
  name            String
  party           String
  partyShort      String?
  symbol          String?  // party symbol emoji or text
  constituency    String
  state           String
  education       String?
  assets          String?  // declared assets in INR
  liabilities     String?
  criminalCases   Int      @default(0)
  experience      String?  // years or description
  age             Int?
  gender          String?
  electionId      String
  election        Election @relation(fields: [electionId], references: [id])
  createdAt       DateTime @default(now())

  @@map("candidates")
}

model PollingBooth {
  id            String   @id @default(cuid())
  boothCode     String   @unique
  name          String
  address       String
  state         String
  district      String
  city          String?
  area          String?
  pincode       String
  contactNumber String?
  timing        String   @default("7:00 AM - 6:00 PM")
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())

  @@index([state, district])
  @@index([pincode])
  @@index([city, area])
  @@map("polling_booths")
}

model Reminder {
  id           String   @id @default(cuid())
  email        String
  name         String?
  electionId   String
  election     Election @relation(fields: [electionId], references: [id])
  reminderDate DateTime
  sent         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("reminders")
}

model SupportRequest {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  state       String
  issue       String
  description String
  status      SupportStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("support_requests")
}

model Feedback {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?
  page      String?
  createdAt DateTime @default(now())

  @@map("feedback")
}

enum ElectionType {
  GENERAL
  STATE_ASSEMBLY
  LOCAL_BODY
  BY_ELECTION
  RAJYA_SABHA
}

enum ElectionStatus {
  UPCOMING
  ONGOING
  COMPLETED
  POSTPONED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model AiInsight {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   // e.g., "trend", "anomaly", "summary"
  tags        String[]
  constituency String?
  state       String?
  relevance   Float    @default(1.0)
  createdAt   DateTime @default(now())

  @@map("ai_insights")
}

model AiAlert {
  id          String   @id @default(cuid())
  type        String   // "misinformation", "turnout_spike", "sentiment_shift"
  severity    String   // "high", "medium", "low"
  message     String
  isRead      Boolean  @default(false)
  location    String?
  createdAt   DateTime @default(now())

  @@map("ai_alerts")
}

model SentimentAnalytics {
  id          String   @id @default(cuid())
  topic       String
  sentiment   Float    // -1.0 to 1.0
  volume      Int
  state       String?
  constituency String?
  timestamp   DateTime @default(now())

  @@map("sentiment_analytics")
}

model MisinformationLog {
  id                 String   @id @default(cuid())
  claim              String
  source             String?
  credibilityScore   Float    // 0.0 to 1.0
  manipulationProb   Float    // 0.0 to 1.0
  aiReasoning        String
  status             String   // "investigating", "debunked", "verified"
  createdAt          DateTime @default(now())

  @@map("misinformation_logs")
}

model ConstituencyIntelligence {
  id            String   @id @default(cuid())
  constituency  String
  state         String
  turnoutPred   Float?   // predicted turnout percentage
  keyIssues     String[]
  aiSummary     String
  lastUpdated   DateTime @default(now()) @updatedAt

  @@unique([constituency, state])
  @@map("constituency_intelligence")
}

model MonitoringEvent {
  id          String   @id @default(cuid())
  eventType   String   // "scan_completed", "anomaly_detected"
  description String
  status      String   // "success", "error", "warning"
  metrics     Json?    // e.g. {"scannedPosts": 1500, "flagged": 12}
  timestamp   DateTime @default(now())

  @@map("monitoring_events")
}

model UploadedDataset {
  id          String   @id @default(cuid())
  fileName    String
  fileSize    Int
  rowCount    Int
  columns     String[]
  status      String   // "processing", "completed", "error"
  createdAt   DateTime @default(now())

  predictions PredictionResult[]

  @@map("uploaded_datasets")
}

model PredictionResult {
  id               String   @id @default(cuid())
  datasetId        String
  dataset          UploadedDataset @relation(fields: [datasetId], references: [id])
  targetVariable   String
  predictionScore  Float
  confidence       Float
  trendDirection   String   // "up", "down", "stable"
  forecastSummary  String
  anomalyAlerts    String[]
  aiExplanation    String
  chartData        Json?    // Store processed Recharts data
  createdAt        DateTime @default(now())

  @@map("prediction_results")
}
